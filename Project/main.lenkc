native(void, """#include <stdio.h>""");

struct List<T>
{
    T` elements;
    ulong count;
    ulong capacity;
}

@List::<T>` list_new<T>(ulong capacity)
{
    let List::<T>` list = malloc::<List::<T>>(1);
    list.elements = malloc::<T>(capacity);
    list.count = 0;
    list.capacity = capacity;
    return list;
}

@void list_add<T>(List::<T>` list, T element)
{
    if (list.count >= list.capacity)
    {
        list.capacity = list.capacity * 2;
        list.elements = realloc::<T>(list.elements, list.capacity);
    }
    list.elements[list.count] = element;
    list.count = list.count + 1;
}

@void list_print_all<T>(List::<T>` list)
{
    let int i = 0;
    while (i < list.count)
    {
        println::<T>(list.elements[i]);
        i = i + 1;
    }
}

@void list_destroy<T>(List::<T>` list)
{
    free::<T>(list.elements);
    free::<List::<T>>(list);
}

@T` malloc<T>(ulong size)
{
    let T` data = cast(
        T`, 
        native(
            void`, 
            #malloc(sizeof(${cname(T)}) * ${size})#
        )
    );
    return data;
}

@T` realloc<T>(T` old_ptr, ulong size)
{

    let T` data = cast(
        T`, 
        native(
            void`, 
            #realloc(${old_ptr}, sizeof(${cname(T)}) * ${size})#
        )
    );
    return data;
}

@void free<T>(T` data)
{
    native(void, #free(${data});#);
}

@void println<T>(T value)
{
    native(void, #printf("${fmt(T)}\n", ${value});#);
}

@int main(int argc, string` argv) {
    infer list = list_new::<int>(2);
    list_add::<int>(list, 1);
    list_add::<int>(list, 2);
    list_add::<int>(list, 3);
    list_add::<int>(list, 4);
    list_print_all::<int>(list);
    list_destroy::<int>(list);
    return 0;
}