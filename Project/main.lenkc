include <stdio.h>
extern int printf(string format, ...);

struct Box<U>
{
    U value;
}

T copy<T>(T input)
{
    T local = input;
    return local;
}

T convert<T>(int input)
{
    T local = (T)input;
    return local;
}

Box::<T> wrap<T>(T input)
{
    Box::<T> box = Box::<T>(input);
    return box;
}

int main()
{
    printf("Generic local: %d (expected 42)\n",
        copy::<int>(42));

    printf("Generic cast: %.1f (expected 7.0)\n",
        convert::<float>(7));

    infer box = wrap::<int>(99);
    printf("Nested generic type: %d (expected 99)\n",
        box.value);

    // These names must no longer be treated as types.
    int T = 40;
    T += 2;

    int U = 5;
    U += 1;

    printf("T scope restored: %d (expected 42)\n", T);
    printf("U scope restored: %d (expected 6)\n", U);

    return 0;
}