include <stdio.h>
extern int printf(string format, ...);

tag string = hashable;
tag string = equatable;

struct Box<T>
{
    T value;
}

tag Box::<int> = container;

int isHashable<T>()
{
    int result = 0;

    comptime if (hastag(T, hashable))
        result = 1;

    return result;
}

int main()
{
    comptime if (hastag(string, hashable))
        printf("PASS: string is hashable\n");
    else
        printf("FAIL: string is missing hashable\n");

    comptime if (hastag(string, equatable))
        printf("PASS: repeated tag declarations accumulate\n");
    else
        printf("FAIL: string is missing equatable\n");

    comptime if (hastag(int, hashable))
        printf("FAIL: int inherited string's tag\n");
    else
        printf("PASS: untagged type returns false\n");

    comptime if (hastag(string, nonexistent))
        printf("FAIL: nonexistent tag returned true\n");
    else
        printf("PASS: nonexistent tag returns false\n");

    comptime if (hastag(Box::<int>, container))
        printf("PASS: generic struct has its tag\n");
    else
        printf("FAIL: generic struct is missing its tag\n");

    comptime if (hastag(Box::<string>, container))
        printf("FAIL: tag leaked between generic specializations\n");
    else
        printf("PASS: generic specializations have separate tags\n");

    printf("Generic string check: %d (expected 1)\n",
        isHashable::<string>());

    printf("Generic int check: %d (expected 0)\n",
        isHashable::<int>());

    return 0;
}