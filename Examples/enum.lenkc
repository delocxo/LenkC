// You can choose any integer type
// But practically, you would use int
enum int Color
{
    Red,
    Blue = 1,
    Green = 1 + 1,
    Yellow = 1 * 3
}

int main()
{
    // Color is just a int under the hood, you can probably use any integer type as long as it fits
    Color color = Color.Red;
    Color blue = Color.Blue;
    int green = Color.Green;
    int result = Color.Yellow + 199 * Color.green;
    return 0;
}