@T` malloc<T>(ulong size)
{
    let T` data = cast(
        T`, 
        native(
            void`, 
            #malloc(sizeof(${cname(T)}) * ${size})#
        )
    );
    return data;
}

@void free<T>(T` data)
{
    native(void, #free(${data});#);
}

@int main(int argc, string` argv) {
    infer data = malloc::<int>(1);
    free::<int>(data);
    return 0;
}