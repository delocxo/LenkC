native(void, """
#include <stdio.h>
""");

native(void, """
typedef struct
{
    char* first_name;
    char* last_name;
} Name;
""");

type Name = "Name" struct
{
    string first_name;
    string last_name;
}


@int main()
{
    let Name name = Name("John", "Doe");
    native(void, #printf("Your name is %s %s.", ${name.first_name}, ${name.last_name});#);
    return 0;
}